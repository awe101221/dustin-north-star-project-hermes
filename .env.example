# ─────────────────────────────────────────────────────────────────────────────
# Dustin North Star Project Hermes — environment
# Copy to .env.local for local dev. On Vercel, add these under Project →
# Settings → Environment Variables (never commit real values).
# ─────────────────────────────────────────────────────────────────────────────

# Live database: Awe Capital "INVESTING-BRAIN-AG" Supabase project.
# Public (browser-safe) — reads go through RLS read policies.
NEXT_PUBLIC_SUPABASE_URL=https://cwiaqczpifnxxcucqwvr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for every write (pipeline moves, notes, trades,
# mandate edits, agent API). Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required fail-closed password gate for the app and confidential service-role
# reads. Both values must be nonblank; the signing secret must be independent.
HERMES_ACCESS_PASSWORD=
# Random 32+ char string used only to sign the access cookie.
HERMES_SESSION_SECRET=

# Bearer token for /api/agent/* (AI agents / automations). Leave blank to
# disable the agent API entirely.
HERMES_AGENT_TOKEN=

# Licensed GuruFocus: news and split-adjusted price-return outcome grading.
# The local weekday job can read the existing key from ~/.hermes/.env.
GURUFOCUS_API_KEY=
# Backtest lab ONLY (stooq | none). NEVER used for forecast outcome grading.
HERMES_PRICE_PROVIDER=stooq

# Scripts only (scripts/db, scripts/migrate): direct Postgres connection string
# from Supabase → Settings → Database (session pooler URI works).
DATABASE_URL=
# Scripts only: read-only reference DB ("Dustin Awe Capital" / investment-brain)
# used exclusively by one-time import scripts. Never read by the app.
LEGACY_INVESTMENT_BRAIN_URL=https://vnxypnpepwxurhbdtswn.supabase.co
LEGACY_INVESTMENT_BRAIN_SERVICE_ROLE_KEY=
# Scripts only: local checkouts of the two legacy repos, read by
# migrate:knowledge and seed:pipeline (default: sibling directories).
LEGACY_AWE_CAPITAL_DIR=../awe-capital
LEGACY_DUSTIN_AWE_CAPITAL_DIR=../dustin-awe-capital
# Short-horizon grading: server/local job only, never NEXT_PUBLIC_.
# Uses GURUFOCUS_API_KEY above. No Alpha Vantage/Massive/Yahoo/Stooq fallback.
# SEC fair-access contact identity, e.g. Organization contact@domain.com
SEC_USER_AGENT=

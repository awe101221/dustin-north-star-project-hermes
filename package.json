{
  "name": "dustin-north-star-project-hermes",
  "version": "0.1.0",
  "private": true,
  "description": "Dustin North Star Project Hermes — quant PM dashboard for beating QQQ over a decade. Next.js + TypeScript + Tailwind + shadcn/ui + Supabase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:migrate": "tsx scripts/db/apply-migrations.ts",
    "db:verify": "tsx scripts/db/verify.ts",
    "migrate:knowledge": "tsx scripts/migrate/import-legacy-knowledge.ts",
    "migrate:performance": "tsx scripts/migrate/import-legacy-performance.ts",
    "migrate:trades": "tsx scripts/migrate/import-legacy-trades.ts",
    "seed:mandate": "tsx scripts/seed/seed-mandate.ts",
    "seed:pipeline": "tsx scripts/seed/seed-pipeline.ts",
    "seed:underwriting": "tsx scripts/seed/seed-underwriting.ts",
    "migrate:all": "npm run seed:mandate && npm run migrate:knowledge && npm run seed:pipeline && npm run seed:underwriting && npm run db:verify",
    "smoke": "tsx scripts/smoke/screenshot-routes.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@supabase/supabase-js": "2.115.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "geist": "1.7.2",
    "lucide-react": "1.41.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "pg": "8.23.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
